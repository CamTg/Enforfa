    {
      "id": "noi",
      "title": "Nói",
      "steps": [
        {
          "type": "text",
          "body": [
            "Bây giờ bạn tự nói. Nghe câu mẫu, thu âm giọng mình, rồi nghe lại hai bản cạnh nhau.",
            "Bản thu chỉ lưu trên điện thoại của bạn, không gửi đi đâu."
          ]
        },
        {
          "type": "speak",
