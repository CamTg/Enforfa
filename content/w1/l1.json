    {
      "id": "hoc",
      "title": "Học",
      "steps": [
        {
          "type": "text",
          "body": [
            "Mỗi ngày bạn học một bài, khoảng 40 phút. Bận thì học từng phần, hôm sau học tiếp từ chỗ dừng. Bỏ một ngày cũng không sao."
          ]
        },
        {
          "type": "text",
          "body": [
            "Chữ tiếng Anh thường không đọc theo mặt chữ như chữ tiếng Việt. Vì vậy, gặp chữ nào bạn cũng bấm nghe trước, rồi mới đọc theo."
          ]
        },
        {
          "type": "text",
          "body": [
            "Đừng ghi cách đọc bằng chữ Việt, kiểu \"hê-lô\". Ghi như vậy, lâu dần bạn sẽ đọc tiếng Anh thành tiếng Việt, và người Mỹ khó hiểu."
          ]
        },
        {
          "type": "text",
          "body": [
            "{{hi}} và {{hello}} đều là lời chào, dùng được với mọi người.",
            "Tiếng Anh không có \"anh, chị, cô, chú\": ai cũng là {{you}}, và người ta thường gọi nhau bằng tên."
          ]
        },
        {
          "type": "text",
          "body": [
            "{{my_name_is_minh}} nghĩa là \"Tên tôi là Minh\".",
            "Nói gọn hơn: {{im_minh}}."
          ]
        },
        {
          "type": "text",
          "body": [
            "{{nice}} là câu nói khi gặp ai lần đầu, như \"Rất vui được gặp bạn\".",
            "Người kia đáp: {{nice_too}}."
          ]
        },
        {
          "type": "text",
          "body": [
            "{{sorry_q}} nói lên giọng ở cuối nghĩa là \"Bạn nói gì cơ?\".",
            "Những tháng đầu ở Mỹ, đây là câu bạn sẽ dùng nhiều nhất, nên đừng ngại dùng nó."
          ]
        },
        {
          "type": "text",
          "body": [
            "{{speak_slowly}} nghĩa là \"Làm ơn nói chậm thôi\".",
            "{{thank_you}} nghĩa là \"Cảm ơn\"."
          ]
        }
      ]
    },
