                  "vi": "Xin chào.",
                  "audio": "c_hello"
                },
                {
                  "en": "My name is Minh.",
                  "vi": "Tên tôi là Minh.",
                  "audio": "c_myname_minh"
                },
                {
                  "en": "Nice to meet you.",
                  "vi": "Rất vui được gặp bạn.",
                  "audio": "c_nice"
                }
              ]
            },
            {
              "speaker": "lan",
              "audio": "d3",
              "chunks": [
                {
                  "en": "Nice to meet you, too.",
                  "vi": "Tôi cũng rất vui được gặp bạn.",
                  "audio": "d3"
                }
              ]
            }
          ]
        },
