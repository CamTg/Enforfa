      "id": "nghe",
      "title": "Nghe",
      "steps": [
        {
          "type": "text",
          "title": "Hai người gặp nhau lần đầu",
          "body": [
            "Bạn sẽ nghe một đoạn hội thoại ngắn ba lượt. Lượt đầu có nghĩa tiếng Việt cho từng cụm, lượt hai có bản dịch cả câu, lượt ba chỉ còn tiếng.",
            "Bạn chưa cần hiểu hết ngay. Bấm vào câu nào cũng nghe lại được."
          ]
        },
        {
          "type": "listen",
          "pass": 1,
          "title": "Lượt 1: nghĩa từng cụm",
          "lines": [
            {
              "speaker": "lan",
              "audio": "d1",
              "chunks": [
